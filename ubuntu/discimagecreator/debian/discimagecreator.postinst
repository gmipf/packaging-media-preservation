#!/bin/sh
# postinst — grant cap_sys_rawio to the real DIC binary so vendor SCSI
# passthrough commands (Plextor D8, Kreon XGD) work without sudo (parity with the
# RPM's %caps). DVDAuth gets none: everything it sends (READ DVD STRUCTURE,
# REPORT KEY, SEND KEY, READ(12), the DVD_AUTH ioctl) the kernel allows to anyone
# who can open the drive. The capability is set on the real binary under
# /usr/lib/discimagecreator/, not the /usr/bin symlinks; the kernel follows the
# symlink on exec. Best-effort: on filesystems that do not support file
# capabilities this is skipped without failing the install.
set -e

case "$1" in
    configure)
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_sys_rawio+ep /usr/lib/discimagecreator/DiscImageCreator.out 2>/dev/null || \
                echo "discimagecreator: could not set cap_sys_rawio on DiscImageCreator.out" \
                     "(filesystem may not support file capabilities); run" \
                     "with sudo if needed." >&2
        fi

        # Make the shipped udev rule take effect on drives that are ALREADY
        # connected. Reloading the rule set only affects future uevents, so a
        # floppy plugged in right now would keep its old permissions until it is
        # physically unplugged and replugged. Re-emit a change event for floppy
        # block devices instead. Best-effort: a container or chroot has no udevd.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --property-match=ID_TYPE=floppy --action=change >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --property-match=ID_USB_TYPE=floppy --action=change >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --sysname-match='fd[0-9]*' --action=change >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
