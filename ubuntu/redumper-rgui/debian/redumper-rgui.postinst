#!/bin/sh
# postinst — grant cap_sys_rawio to the pinned redumper binary so vendor SCSI
# passthrough commands work without sudo (parity with the RPM's %caps and with
# the rolling redumper package's postinst).
#
# The capability belongs on THIS binary and on no GUI that drives it: a file
# capability makes a process non-dumpable, and a non-dumpable process is refused
# by the XDG desktop portal, which kills every file dialog. That is exactly how
# mpf-gui died. The GUI stays plain; the tool that talks SCSI carries the cap,
# and the kernel propagates it across exec.
#
# Best-effort: on filesystems that do not support file capabilities (some
# overlay / container setups) this is skipped without failing the install.
set -e

case "$1" in
    configure)
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_sys_rawio+ep /usr/bin/redumper-rgui 2>/dev/null || \
                echo "redumper-rgui: could not set cap_sys_rawio (filesystem may not" \
                     "support file capabilities); run redumper-rgui with sudo or add" \
                     "the capability manually." >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
