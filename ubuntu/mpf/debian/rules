#!/usr/bin/make -f
#
# mpf — repackage of three upstream self-contained .NET binaries (Check, CLI,
# Avalonia GUI) from one rolling release. Nothing is compiled; the /usr/bin
# wrappers are generated from a shared template and the dlopened .NET runtime
# deps are declared by hand (manpages are static).

%:
	dh $@

# %prep, in Debian's clothes.
#
# The three upstream archives arrive in the source tree exactly as
# upstream publishes them: MPF.Check is the .orig tarball, the CLI and GUI zips
# come in through the .dsc's Debtransform-Files (which is what Source1:/Source2:
# are to an RPM spec). Unpacking them HERE is what lets this lane build straight
# from upstream, with no tarball assembled and re-hosted by us in between.
#
# Nothing is downloaded here and nothing may be: the build root has no network,
# on OBS just as in a COPR chroot.
# On arm64 the arch-matching trio is unpacked instead. MPF.Check is the .orig
# tarball, so dpkg-source has already laid down the x86-64 build at the top of
# the tree -- the arm64 Check zip (a Debtransform-Files extra, like the other
# two) is unzipped OVER it. The CLI and GUI come from their arm64 zips directly.
# arm64 ships UNTESTED (no hardware drive-access proof).
#
# The zips are found by their FORM, MPF.<tool>_<net>_linux-<rid>_<config>.zip,
# not by a literal name: the .NET version and the build configuration in the
# name are macros of the RPM specs, which the watcher rewrites when upstream
# renames its assets (net10.0 release became net11.0 debug on 2026-11-13). The
# .dsc is generated from those specs, so the tree holds exactly one zip per tool
# and arch; zero or two is a broken source package and fails the build here.
MPF_RID := $(if $(filter arm64,$(DEB_HOST_ARCH)),arm64,x64)
MPF_ZIP = $(firstword $(wildcard MPF.$(1)_*_linux-$(MPF_RID)_*.zip))
MPF_ZIPS = $(wildcard MPF.$(1)_*_linux-$(MPF_RID)_*.zip)

# The sha256 of each upstream file, the same values as the mpfsha_* macros of
# both RPM specs: taken from MPF's own "Build and Test" run for this version's
# commit. The rolling URLs serve whatever MPF uploaded last, so a rebuild after
# MPF moved on would get newer zips under this version; the build fails on any
# other file instead. Written by watch-mpf-rolling.yml through
# scripts/mpf-pins.py; lint.sh fails when the three recipes differ.
# MPF.Check for linux-x64 is the .orig tarball here: dpkg-source has unpacked
# it before this file runs, so its binary is pinned instead of its zip.
MPF_SHA256_Check_x64_binary := 392cb935b38a58040777875f9ab121d320728b8e7de8677a82155f24e684b174
MPF_SHA256_CLI_x64          := 496afaa59f711c8d684aaed058d2006793b1356d6a55030b919bd78030601027
MPF_SHA256_Avalonia_x64     := 9dc28e6ea5a562fa8b534b043583de84074f27a7f55ed3021055d8fac1799a4c
MPF_SHA256_Check_arm64      := ebd9eaa9aaa27b4ce488b1ce7e03bffe2c44ec4909491512386bf5ca53316580
MPF_SHA256_CLI_arm64        := e5261a023b4f74407e3bc8f1671c0034dc1318d1576bdd056b868f6a16df3588
MPF_SHA256_Avalonia_arm64   := f1e4b94947bee730f2a63b5e9424cd297c4890ef1f660ac26e52a3e92d94bbd2
MPF_ZIP_FOR = $(wildcard MPF.$(1)_*_linux-$(2)_*.zip)

execute_before_dh_auto_build:
	# Every upstream file must be the pinned one, checked before anything is
	# unpacked over the tree (the arm64 Check zip lands on top of MPF.Check).
	# A missing zip, or two of one kind, leave a line sha256sum rejects.
	printf '%s  %s\n' \
	    '$(MPF_SHA256_Check_x64_binary)' MPF.Check \
	    '$(MPF_SHA256_CLI_x64)' '$(call MPF_ZIP_FOR,CLI,x64)' \
	    '$(MPF_SHA256_Avalonia_x64)' '$(call MPF_ZIP_FOR,Avalonia,x64)' \
	    '$(MPF_SHA256_Check_arm64)' '$(call MPF_ZIP_FOR,Check,arm64)' \
	    '$(MPF_SHA256_CLI_arm64)' '$(call MPF_ZIP_FOR,CLI,arm64)' \
	    '$(MPF_SHA256_Avalonia_arm64)' '$(call MPF_ZIP_FOR,Avalonia,arm64)' \
	  | sha256sum --check --strict --quiet -
	mkdir -p cli gui
	test "$(words $(call MPF_ZIPS,CLI))" = 1 && test "$(words $(call MPF_ZIPS,Avalonia))" = 1 \
	    || { echo "expected exactly one CLI and one Avalonia zip for linux-$(MPF_RID): '$(call MPF_ZIPS,CLI)' '$(call MPF_ZIPS,Avalonia)'" >&2; exit 1; }
ifeq ($(DEB_HOST_ARCH),arm64)
	test "$(words $(call MPF_ZIPS,Check))" = 1 \
	    || { echo "expected exactly one Check zip for linux-arm64: '$(call MPF_ZIPS,Check)'" >&2; exit 1; }
	unzip -q -o $(call MPF_ZIP,Check)
endif
	unzip -q -o $(call MPF_ZIP,CLI) -d cli
	unzip -q -o $(call MPF_ZIP,Avalonia) -d gui
	# Upstream bundles its own dumpers under Programs/. They go: these packages
	# point MPF at the system-installed ones (see the Recommends in control), and
	# shipping a second, unmanaged copy is exactly what we are here to avoid.
	rm -rf cli/Programs gui/Programs
	# Upstream names the GUI binary MPF; ours is MPF.Avalonia, matching the RPM.
	test ! -e gui/MPF || mv gui/MPF gui/MPF.Avalonia
	chmod 0755 MPF.Check cli/MPF.CLI gui/MPF.Avalonia

override_dh_auto_test:

# Do not strip the self-contained single-file .NET binaries — stripping would
# corrupt them and diverge from the published release.
override_dh_strip:

override_dh_dwz:

# ImageMagick 7 renamed the CLI to `magick` and drops `convert`; ImageMagick 6
# has only `convert`. Both are in play across our targets (jammy/noble and
# Debian 12 carry IM6; Debian 13 and Ubuntu 26.04 carry IM7), so resolve the
# name in the build root instead of hardcoding either one.
IM := $(shell command -v magick >/dev/null 2>&1 && echo magick || echo convert)

# Generate the three /usr/bin wrappers from the shared template (seed/heal the
# dumper paths in ~/.config/mpf/config.json) and lay down the GUI desktop entry
# and hicolor icons — all packaging artifacts, absent from the upstream zips.
execute_after_dh_install:
	install -d debian/mpf-check/usr/bin
	sed 's|@TARGET@|/usr/lib/mpf-check/MPF.Check|' debian/mpf-wrapper.in > debian/mpf-check/usr/bin/mpf-check
	chmod 0755 debian/mpf-check/usr/bin/mpf-check
	install -d debian/mpf-cli/usr/bin
	sed 's|@TARGET@|/usr/lib/mpf-cli/MPF.CLI|' debian/mpf-wrapper.in > debian/mpf-cli/usr/bin/mpf-cli
	chmod 0755 debian/mpf-cli/usr/bin/mpf-cli
	install -d debian/mpf-gui/usr/bin
	sed 's|@TARGET@|/usr/lib/mpf-gui/MPF.Avalonia|' debian/mpf-wrapper.in > debian/mpf-gui/usr/bin/mpf-gui
	chmod 0755 debian/mpf-gui/usr/bin/mpf-gui
	install -D -m0644 debian/mpf-gui.desktop debian/mpf-gui/usr/share/applications/mpf-gui.desktop
# Icons: we used to ship 32/64/128/256/512 only, as five pre-rendered PNGs in
# debian/. The sizes a panel or dock actually reaches for -- 16, 22, 24, 48 --
# were missing, so the desktop downscaled the 32 (or the 512) on the fly for
# every taskbar slot. Now ONE master (debian/mpf-512.png) is kept and the rest
# is rendered here with a proper Lanczos filter. Five files kept in lockstep are
# five chances to update four of them; the dropped ones were plain downscales
# anyway (RMSE < 0.02 against a fresh resample -- measured before removing them).
	for sz in 16 22 24 32 48 64 128 256; do \
	    install -d debian/mpf-gui/usr/share/icons/hicolor/$${sz}x$${sz}/apps; \
	    $(IM) debian/mpf-512.png -filter Lanczos -resize $${sz}x$${sz} \
	        debian/mpf-gui/usr/share/icons/hicolor/$${sz}x$${sz}/apps/mpf.png; \
	done
	install -D -m0644 debian/mpf-512.png debian/mpf-gui/usr/share/icons/hicolor/512x512/apps/mpf.png
# A hicolor dir that exists but holds no icon is worse than none -- the launcher
# silently comes up blank. Fail the build instead of shipping that.
	for sz in 16 22 24 32 48 64 128 256 512; do \
	    test -s debian/mpf-gui/usr/share/icons/hicolor/$${sz}x$${sz}/apps/mpf.png \
	        || { echo "icon $${sz}x$${sz} missing or empty"; exit 1; }; \
	done

# The ICU runtime package carries its soname in its name (libicu74 noble /
# libicu70 jammy), so resolve it per-series and feed control's ${dep:icu} for
# each of the three self-contained subpackages.
override_dh_gencontrol:
	ICU=$$(dpkg-query -W -f='$${Package}\n' 'libicu[0-9]*' 2>/dev/null | grep -E '^libicu[0-9]+$$' | sort -V | tail -n1); \
	for p in mpf-check mpf-cli mpf-gui; do echo "dep:icu=$$ICU" >> debian/$$p.substvars; done
	dh_gencontrol
