#!/bin/sh
# postinst — grant cap_sys_rawio to the real aaru binary so vendor SCSI
# passthrough commands work without sudo (parity with the RPM's %caps). The
# capability is set on the real binary under /usr/lib/aaru/, not the
# /usr/bin/aaru symlink; the kernel follows the symlink on exec. Best-effort:
# on filesystems that do not support file capabilities (some overlay /
# container setups) this is skipped without failing the install.
set -e

case "$1" in
    configure)
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_sys_rawio+ep /usr/lib/aaru/aaru 2>/dev/null || \
                echo "aaru: could not set cap_sys_rawio (filesystem may not" \
                     "support file capabilities); run aaru with sudo or add" \
                     "the capability manually." >&2
        fi

        # Make the shipped udev rule take effect on drives that are ALREADY
        # connected. Reloading the rule set only affects future uevents, so a
        # floppy plugged in right now would keep its old permissions until it is
        # physically unplugged and replugged. Re-emit a change event for floppy
        # block devices instead. Best-effort: a container or chroot has no udevd.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --property-match=ID_TYPE=floppy --action=change >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --property-match=ID_USB_TYPE=floppy --action=change >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=block --sysname-match='fd[0-9]*' --action=change >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
