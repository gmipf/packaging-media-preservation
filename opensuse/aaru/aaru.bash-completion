# _mediapres_aaru_value <node> <option>: complete the option's value; numbers, free
# text and the lists aaru only knows at run time get nothing
_mediapres_aaru_value()
{
    case $1/$2 in
        archive/--logfile|device/--logfile|'device info/-w'|'device info/--output-prefix'|filesystem/--logfile|image/--logfile|'image analyze/-r'|'image analyze/--resume-file'|'image convert/-x'|'image convert/--cicm-xml'|'image convert/-r'|'image convert/--resume-file'|'image convert/-m'|'image convert/--aaru-metadata'|'image merge/--sectors-file'|'image merge/--primary-resume'|'image merge/--secondary-resume'|media/--logfile|'media info/-w'|'media info/--output-prefix'|'media scan/-m'|'media scan/--mhdd-log'|'media scan/-b'|'media scan/--ibg-log'|'media dump/-x'|'media dump/--cicm-xml'|'media dump/--aaru-metadata'|database/--logfile|configure/--logfile|formats/--logfile|list-encodings/--logfile|list-namespaces/--logfile|remote/--logfile|metadata-schema/--logfile)
            _filedir
            ;;
        'image decode/-l'|'image decode/--length')
            mapfile -t COMPREPLY < <(compgen -W all -- "$cur")
            ;;
        'media dump/--subchannel')
            mapfile -t COMPREPLY < <(compgen -W 'any rw rw-or-pq pq none' -- "$cur")
            ;;
    esac
}

_mediapres_aaru_devices()
{
    local d
    COMPREPLY=()
    for d in /dev/mmcblk* /dev/sd* /dev/sg* /dev/sr* /dev/st*; do
        [[ -e $d && $d == "$cur"* ]] && COMPREPLY+=("$d")
    done
    ((${#COMPREPLY[@]})) || _filedir
}

_mediapres_aaru()
{
    local cur prev words cword split
    _init_completion -s || return

    local node='' skip='' w lw i REPLY subs opts vopts tflags args
    local -a pos=() kinds=()
    for ((i = 1; i < cword; i++)); do
        w=${words[i]}
        if [[ $skip == value ]]; then
            skip=''
            continue
        fi
        lw=${w,,}
        if [[ $skip == flag ]]; then
            skip=''
            [[ $lw == true || $lw == false ]] && continue
        fi
        case $w in
            --)
                return
                ;;
            -*)
                # before the first command: help, version or an error
                [[ -z $node ]] && return
                [[ $w == *=* ]] && continue
                _mediapres_aaru_node "$node"
                if [[ " $vopts " == *[[:space:]]"$w"[[:space:]]* ]]; then skip=value; else skip=flag; fi
                ;;
            *)
                [[ -z $node && $lw == gui ]] && return
                _mediapres_aaru_node "$node"
                if [[ $subs ]]; then
                    _mediapres_aaru_child "$node" "$w"
                    [[ $REPLY ]] || return
                    node=$REPLY
                else
                    pos+=("$w")
                fi
                ;;
        esac
    done

    _mediapres_aaru_node "$node"
    if [[ $skip == value ]] || { $split && [[ " $vopts " == *[[:space:]]"$prev"[[:space:]]* ]]; }; then
        _mediapres_aaru_value "$node" "$prev"
        return
    fi
    if $split || { [[ $skip == flag && " $tflags " == *[[:space:]]"$prev"[[:space:]]* && $cur != -* ]] &&
        [[ false == "${cur,,}"* || true == "${cur,,}"* ]]; }; then
        mapfile -t COMPREPLY < <(compgen -W 'false true' -- "${cur,,}")
        return
    fi
    if [[ $cur == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return
    fi
    if [[ $subs ]]; then
        [[ -z $node ]] && ((cword == 1)) && subs+=" gui"
        mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
        return
    fi
    read -ra kinds <<<"$args"
    w=${kinds[${#pos[@]}]-}
    ((${#kinds[@]})) && [[ -z $w && ${kinds[-1]} == commands ]] && w=commands
    case $w in
        file) _filedir ;;
        dir) _filedir -d ;;
        device) _mediapres_aaru_devices ;;
        host) _known_hosts_real -- "$cur" ;;
        commands)
            # a command path: aaru cli explain image convert
            node=''
            for w in "${pos[@]}"; do
                _mediapres_aaru_child "$node" "$w"
                [[ $REPLY ]] || return
                node=$REPLY
            done
            _mediapres_aaru_node "$node"
            mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
            ;;
    esac
} &&
    complete -F _mediapres_aaru aaru

