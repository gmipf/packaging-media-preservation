<services>
  <!--
    OBS builds are hermetic (no network in the build root), so all four upstream
    source archives must be fetched at *service* time and committed as package
    sources.

    download_files parses the spec's Source: URLs and downloads each one. DIC's
    Source lines use rpm's `#/rename` convention (Source0..Source3), and
    download_files honours it: it splits on "#/" and stores the download under
    the name that follows. So no per-archive download_url services are needed -
    one download_files covers all four, exactly like the other four tools in
    this repo.

    Because it reads the URLs straight from the spec, a DIC master-commit bump
    only has to touch %{diccommit}/%{dicsnap} in the spec - this _service never
    changes. (The previous download_url version hard-coded the commit here too,
    so every bump had to be made in two places.)

    Source4 (discimagecreator.1) and Source5 (the udev rule) are local files,
    not URLs, so they are left untouched.

    mode="manual": run it locally and commit the results.

        osc service manualrun        # downloads the four archives
        osc addremove                # stage the freshly downloaded files
        osc commit                   # spec + _service + archives in one revision
  -->
  <service name="download_files" mode="manual"/>
</services>
