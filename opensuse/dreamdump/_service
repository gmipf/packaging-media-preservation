<services>
  <!-- OBS pulls EVERYTHING itself; `_service` is the only file committed to OBS.
       Same shape as every other tool in this lane, see opensuse/README.md.

       1. download_url fetches the SPEC straight from `main` of the packaging
          repo, so git stays the single source of truth. Only the spec: it is the
          one file that cannot fetch itself.
       2. download_files then reads that spec and downloads every Source: URL in
          it: the upstream source tarball, both release binaries, and our build
          helper. OBS build roots have no network, so they must exist as package
          sources before the build starts.

       This file depends on the PACKAGE NAME only and never has to change again;
       a new dreamdump release is a git commit, nothing in OBS.
       (No double hyphens anywhere in here: XML forbids them inside a comment
       and OBS rejects the whole file for it.) -->
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/dreamdump/dreamdump.spec</param>
    <param name="filename">dreamdump.spec</param>
  </service>
  <!-- upstream assets, taken from the Source: URLs of the spec above -->
  <service name="download_files"/>
  <!-- BEGIN deb · generated by scripts/obs/gen-deb.sh · do not edit by hand.
       Keep double hyphens out of this comment: XML forbids them inside a
       comment, and OBS then rejects the whole _service file, not just it.

       No upstream archive is fetched here. download_files above already pulled
       the spec's Source: URLs, and the .dsc names those very files: the RPM and
       the .deb are built from the same upstream bytes, downloaded once. -->
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/dreamdump/dreamdump.dsc</param>
    <param name="filename">dreamdump.dsc</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/dreamdump/debian.tar.gz</param>
    <param name="filename">debian.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/ubuntu/dreamdump/debian/changelog</param>
    <param name="filename">debian.changelog</param>
  </service>
  <!-- END deb -->
</services>
