<services>
  <!-- OBS pulls EVERYTHING itself; `_service` is the only file committed to OBS.

       1. download_url fetches each recipe file (spec, manpages, udev rule, icons,
          rpmlintrc) straight from `main` of the packaging repo, so git stays the
          single source of truth: a push is all it takes, there is no second copy
          of the recipe to keep in sync.
       2. download_files then reads the *generated* spec and downloads the upstream
          assets named in its Source: URLs. It supports service-generated specs on
          purpose - it strips the `_service:<svc>:` prefix when globbing for *.spec.

       The services run SERVER-SIDE (no mode= attribute), so a scoped `runservice`
       token can refresh a package (.github/workflows/obs-trigger.yml). An OBS token
       can never commit - which is precisely why the recipe has to be fetched by OBS
       rather than pushed to it.

       Deliberately NOT tar_scm: it always also produces a tarball whose name carries
       the git commit, so every unrelated push to main would change the sources of
       all five packages and rebuild them for nothing. download_url writes only the
       files themselves: an unchanged recipe keeps verifymd5 stable -> no rebuild. -->
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/redumper/redumper-rpmlintrc</param>
    <param name="filename">redumper-rpmlintrc</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/redumper/redumper.1</param>
    <param name="filename">redumper.1</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/redumper/redumper.spec</param>
    <param name="filename">redumper.spec</param>
  </service>
  <!-- upstream assets, taken from the Source: URLs of the spec above -->
  <service name="download_files"/>
  <!-- BEGIN deb · generated by scripts/obs/gen-deb.sh · do not edit by hand.
       Keep double hyphens out of this comment: XML forbids them inside a
       comment, and OBS then rejects the whole _service file, not just it. -->
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/redumper/redumper.dsc</param>
    <param name="filename">redumper.dsc</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/opensuse/redumper/debian.tar.gz</param>
    <param name="filename">debian.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="url">https://raw.githubusercontent.com/gmipf/packaging-media-preservation/main/ubuntu/redumper/debian/changelog</param>
    <param name="filename">debian.changelog</param>
  </service>
  <service name="download_url">
    <param name="url">https://launchpad.net/~dreunion61/+archive/ubuntu/media-preservation/+files/redumper_732.orig.tar.xz</param>
    <param name="filename">redumper-732.tar.xz</param>
  </service>
  <!-- END deb -->
</services>
