#!/usr/bin/env bash
#
# Enforces the proof ledger on every commit. Install once per clone:
#
#     git config core.hooksPath .githooks
#
# WHAT THIS BLOCKS (and only this):
#   * DRIFT     — a recipe fragment changed under a standing proof. The proof is
#                 stale; measure again or the green is a lie.
#   * COVERAGE  — a %caps() / udev rule / setcap-postinst / permissions profile
#                 with no ledger line at all.
#   * a proof or blockade pointing at an artifact that does not exist.
#   * a blockade whose upstream version moved.
#   * a lint finding (scripts/lint.sh --hook: the rules CI enforces; a linter not
#     installed on this machine is named and skipped, CI runs it regardless).
#
# WHAT THIS DOES NOT BLOCK:
#   * the open backlog. A 'not-yet' row is not a failure -- you must be able to
#     commit a new mechanism together with the ledger line that says it is unproven.
#
# That split is the whole reason this hook can exist today. The original plan was
# "prove everything, THEN switch enforcement on", which chained two unrelated
# things to one switch: drift+coverage (mechanical, waits for nobody) and
# completeness (which waited on an upstream bug in aaru5 that will never resolve
# on our schedule). A gate whose arming depends on a stranger never arms.
#
# Escape hatch: there is none for an agent session. Bypassing this hook is the
# maintainer's call, made at their own terminal. A red ledger gets its cause fixed.
#
# ENTRY: not keyed on the checker's exec bit. Until 2026-10-12 this read
# `[ -x proof-status.sh ] || exit 0`: an exec bit lost in a sync or a checkout
# switched the whole check off without a word. Now the checker runs via `bash`.
# The hook steps aside only in a tree with NEITHER ledger NOR checker. Either
# one alone is red: a ledger without its checker, or a checker without its
# ledger (proof-status.sh fails on that itself).
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 0

# In a linked worktree git runs this hook with GIT_DIR exported (the worktree's
# own gitdir) and no GIT_WORK_TREE. A helper that asks git for the top level
# from its own directory (gen-deb.sh: `git -C scripts/obs rev-parse
# --show-toplevel`) then gets that directory back, finds no recipes and reports
# every one of them stale (measured 2026-10-14). Naming the work tree gives
# those helpers the right answer again; outside a worktree GIT_DIR is unset and
# nothing changes.
if [ -n "${GIT_DIR:-}" ] && [ -z "${GIT_WORK_TREE:-}" ]; then
    export GIT_WORK_TREE="$root"
fi

ledger="$root/scripts/proof-ledger.tsv"
checker="$root/scripts/proof-status.sh"
[ -e "$ledger" ] || [ -e "$checker" ] || exit 0

if [ ! -f "$checker" ]; then
    echo "pre-commit: scripts/proof-ledger.tsv ist da, scripts/proof-status.sh fehlt —" >&2
    echo "            ein Ledger ohne Prüfer prüft nichts. Commit abgebrochen." >&2
    exit 1
fi

if ! bash "$checker"; then
    echo
    echo "pre-commit: das Beweis-Ledger ist nicht sauber (siehe oben) — Commit abgebrochen." >&2
    echo "            Beweis nachgemessen? Dann Zeile setzen + 'scripts/proof-status.sh --refresh'." >&2
    echo "            Bewusste Ausnahme? Entscheidet nur der Maintainer, nicht die Sitzung." >&2
    exit 1
fi

if ! bash "$root/scripts/lint.sh" --hook; then
    echo
    echo "pre-commit: Lint-Befund (siehe oben) — Commit abgebrochen." >&2
    exit 1
fi
